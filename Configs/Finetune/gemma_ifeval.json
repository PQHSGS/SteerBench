{
  "name": "gemma_ifeval",
  "description": "LoRA finetune config for ifeval, evaluated on ifeval",
  "model_name": "google/gemma-2-2b-it",
  "train_dataset": "ifeval",
  "n_train": 300,
  "test_dataset": "ifeval",
  "n_test": 50,
  "apply_chat_template": true,
  "method_name": "lora",
  "backend": "peft",
  "output": "./Results/finetune",
  "compute_perplexity": true,
  "eval_max_new_tokens": 128,
  "seed": 42,
  "device": "cuda",
  "dtype": "bfloat16",
  "num_epochs": 3,
  "train_batch_size": 2,
  "eval_batch_size": 4,
  "gradient_accumulation_steps": 1,
  "learning_rate": 2e-4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.03,
  "max_length": 2048,
  "grad_clip": 1.0,
  "save_vector": "./Vector/FINETUNE/gemma_ifeval",
  "method": {
    "name": "lora",
    "backend": "peft",
    "r": 32,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "bias": "none",
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj"
    ]
  }
}
