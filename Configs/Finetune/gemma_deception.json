{
  "name": "gemma_deception",
  "description": "LoRA finetune config for deception, evaluated on deception",
  "model_name": "google/gemma-2-2b-it",
  "train_dataset": "liarbench",
  "n_train": 500,
  "test_dataset": "liarbench",
  "n_test": 100,
  "apply_chat_template": true,
  "method_name": "lora",
  "backend": "peft",
  "output": "./Results/finetune",
  "compute_perplexity": true,
  "eval_max_new_tokens": 128,
  "seed": 42,
  "device": "cuda:4",
  "dtype": "bfloat16",
  "num_epochs": 5,
  "train_batch_size": 8,
  "eval_batch_size": 8,
  "grad_accum": 4,
  "learning_rate": 2e-4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.03,
  "max_length": 2048,
  "grad_clip": 2.0,
  "save_vector": "./Vector/FINETUNE/gemma_deception",
  "inverse": true,
  "method": {
    "name": "lora",
    "backend": "peft",
    "r": 32,
    "lora_alpha": 16,
    "lora_dropout": 0.2,
    "bias": "none",
    "target_modules": ["v_proj", "o_proj", "up_proj", "down_proj"]
  }
}
