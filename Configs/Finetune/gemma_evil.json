{
  "name": "gemma_evil",
  "description": "LoRA finetune config for evil_content, evaluated on evil_content",
  "model_name": "google/gemma-2-2b-it",
  "train_dataset": "evil",
  "n_train": 500,
  "test_dataset": "evil",
  "n_test": 100,
  "apply_chat_template": true,
  "method_name": "lora",
  "backend": "peft",
  "output": "./Results/finetune",
  "compute_perplexity": true,
  "eval_max_new_tokens": 128,
  "seed": 42,
  "device": "cuda:4",
  "dtype": "bfloat16",
  "num_epochs": 10,
  "train_batch_size": 8,
  "eval_batch_size": 4,
  "grad_accum": 4,
  "learning_rate": 0.0002,
  "weight_decay": 0.01,
  "warmup_ratio": 0.03,
  "max_length": 2048,
  "grad_clip": 10.0,
  "save_vector": "Vector/FINETUNE/gemma_evil",
  "method": {
    "name": "lora",
    "backend": "peft",
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "bias": "none",
    "target_modules": [
      "up_proj",
      "down_proj",
      "gate_proj"
    ]
  }
}