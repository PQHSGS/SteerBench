{
  "name": "gemma_roleplay_gms8k",
  "description": "SRPS with roleplay personas for math reasoning (GMS8K)",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16"
  },
  "extractor": {
    "method": "SRPS",
    "layer": [
      25
    ],
    "batch_size": 4,
    "position": "last",
    "beta": 1.0,
    "top_k": 15,
    "apply_chat_template": false,
    "train_dataset": "srps_roleplay_gms8k",
    "n_train": 100
  },
  "steer": {
    "method": "SRPS",
    "layer": 12,
    "coeff": 1.0,
    "apply_chat_template": false,
    "n_test": 50
  },
  "test_dataset": "gms8k",
  "output": "./Results/srps"
}