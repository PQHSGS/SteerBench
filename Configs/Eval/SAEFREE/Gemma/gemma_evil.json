{
  "name": "gemma_evil",
  "description": "SAE-FREE evil steering evaluated on evil",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAE-FREE",
    "layer": [
      14
    ],
    "batch_size": 4,
    "position": "last",
    "hook_point": "pre",
    "apply_chat_template": true,
    "saefree_component_idx": -1,
    "saefree_center_diffs": false,
    "saefree_cov_normalize": false,
    "saefree_align_sign": true,
    "inverse": false
  },
  "steer": {
    "method": "SAE-FREE",
    "layer": [
      14
    ],
    "coeff": 1.0,
    "position": "last",
    "hook_point": "pre",
    "apply_chat_template": true,
    "saefree_norm_eps": 1e-08
  },
  "train_dataset": "evil",
  "n_train": 500,
  "test_dataset": "evil",
  "n_test": 100,
  "save_vector": "Vector/SAEFREE/Gemma/evil",
  "output": "./Results/saefree",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}