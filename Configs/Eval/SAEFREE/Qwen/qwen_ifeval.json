{
  "name": "qwen_ifeval",
  "description": "SAEFREE steering for ifeval",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAE-FREE",
    "layer": [
      18
    ],
    "batch_size": 4,
    "position": "last",
    "hook_point": "pre",
    "apply_chat_template": true,
    "saefree_component_idx": -1,
    "saefree_center_diffs": false,
    "saefree_cov_normalize": false,
    "saefree_align_sign": true
  },
  "steer": {
    "method": "SAE-FREE",
    "layer": [
      18
    ],
    "coeff": 1.0,
    "position": "last",
    "hook_point": "pre",
    "apply_chat_template": true,
    "saefree_norm_eps": 1e-08
  },
  "train_dataset": "ifeval",
  "n_train": 1000,
  "test_dataset": "ifeval",
  "n_test": 100,
  "save_vector": "Vector/SAEFREE/Qwen/ifeval",
  "output": "./Results/saefree",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}