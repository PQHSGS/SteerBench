{
  "name": "qwen_refusal_response",
  "description": "COBRA steering on refusal_response",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "COBRA",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "inverse": false,
    "cobra_k": 20,
    "cobra_lambda": 0.1,
    "cobra_dim": 8
  },
  "steer": {
    "method": "COBRA",
    "layer": 18,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 1,
    "steer_once": false
  },
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "refusal_open",
  "save_vector": "Vector/COBRA/Qwen/refusal_response",
  "n_test": 100,
  "n_train": null,
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/cobra",
  "seed": 42
}