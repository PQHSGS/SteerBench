{
  "name": "qwen_ifeval",
  "description": "COBRA steering on ifeval",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "COBRA",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "inverse": false,
    "cobra_k": 5,
    "cobra_lambda": 0.1,
    "cobra_dim": 8
  },
  "steer": {
    "method": "COBRA",
    "layer": 18,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 1.0,
    "steer_once": false
  },
  "train_dataset": "ifeval",
  "test_dataset": "ifeval",
  "save_vector": "Vector/COBRA/Qwen/ifeval",
  "n_test": 100,
  "n_train": 500,
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/cobra",
  "seed": 42
}