{
  "name": "gemma_sorrybench",
  "description": "CAA steering trained on refusal, evaluated on SorryBench",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 14,
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "CAA",
    "layer": 14,
    "coeff": 1.0,
    "apply_chat_template": true,
    "hook_point": "pre",
    "batch_size": 4
  },
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "load_vector": "Vector/CAA/Gemma/ai_risk_refusal",
  "test_dataset": "sorrybench",
  "n_test": null,
  "output": "./Results/caa",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}