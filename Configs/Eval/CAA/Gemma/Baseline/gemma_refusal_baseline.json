{
  "name": "gemma_refusal_baseline",
  "description": "CAA coeff=0 baseline for refusal — captures unsteered LSP score",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:5",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": false,
    "method": "CAA",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "CAA",
    "layer": 14,
    "coeff": 0,
    "apply_chat_template": true,
    "hook_point": "pre",
    "steer_once": false
  },
  "save_vector": "Vector/CAA/Gemma/refusal_response",
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "refusal_open",
  "output": "./Results/Baseline",
  "compute_perplexity": true,
  "compute_lsp": true,
  "include_baseline": false,
  "seed": 42,
  "n_test": 100
}
