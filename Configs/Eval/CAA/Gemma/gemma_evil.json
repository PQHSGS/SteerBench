{
  "name": "gemma_evil",
  "description": "CAA evil steering evaluated on evil",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:5",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "inverse": false,
    "position": "mask"
  },
  "steer": {
    "method": "CAA",
    "layer": 14,
    "coeff": 1,
    "apply_chat_template": true,
    "hook_point": "pre",
    "steer_once": false
  },
  "save_vector": "Vector/CAA/Gemma/evil",
  "train_dataset": "evil",
  "test_dataset": "evil",
  "output": "./Results/caa",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "n_test": 100,
  "n_train": 500
}