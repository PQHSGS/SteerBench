{
  "name": "gemma_coordinate_open",
  "description": "CAA steering trained on coordinate, evaluated on coordinate_open",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 14,
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "apply_chat_template": true,
    "train_dataset": "ai_risk_coordinate",
    "n_train": 360
  },
  "steer": {
    "method": "CAA",
    "layer": 13,
    "coeff": 1.005,
    "apply_chat_template": true,
    "hook_point": "pre"
  },
  "save_vector": "Vector/CAA/Gemma/ai_risk_coordinate",
  "test_dataset": "coordinate_open",
  "n_test": 500,
  "output": "./Results/caa",
  "seed": 42
}