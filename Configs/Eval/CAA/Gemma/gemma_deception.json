{
  "name": "gemma_deception",
  "description": "CAA deception steering evaluated on deception",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:4",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": true,
    "method": "CAA",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "ot_steer": true
  },
  "steer": {
    "method": "CAA",
    "layer": 14,
    "coeff": 5,
    "apply_chat_template": true,
    "hook_point": "pre",
    "steer_once": true,
    "ot_steer": true
  },
  "save_vector": "Vector/CAA/Gemma/deception",
  "train_dataset": "liarbench",
  "test_dataset": "liarbench",
  "output": "./Results/caa",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "n_test": 100
}