{
  "name": "llama_refusal_response",
  "description": "CAA steering trained on refusal_response, evaluated on refusal_open",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 7,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "CAA",
    "layer": 7,
    "coeff": 1.0,
    "apply_chat_template": true,
    "hook_point": "pre"
  },
  "save_vector": "Vector/CAA/Llama/refusal_response",
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "refusal_open",
  "output": "./Results/caa",
  "compute_perplexity": true,
  "include_baseline": true,
  "seed": 42
}