{
  "name": "llama_hallu_ab",
  "description": "CAA steering trained on hallucination, evaluated on hallucination_ab",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 7,
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "CAA",
    "layer": 7,
    "coeff": 1.0,
    "apply_chat_template": true,
    "hook_point": "pre"
  },
  "n_test": 500,
  "save_vector": "Vector/CAA/Llama/ai_risk_hallucination",
  "train_dataset": "hallucination",
  "test_dataset": "hallucination_ab",
  "output": "./Results/caa",
  "seed": 42
}