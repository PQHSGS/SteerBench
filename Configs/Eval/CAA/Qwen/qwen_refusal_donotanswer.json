{
  "name": "qwen_refusal_donotanswer",
  "description": "CAA steering trained on refusal, evaluated on DoNotAnswer",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 18,
    "batch_size": 4,
    "position": -2,
    "hook_point": "post",
    "apply_chat_template": false,
    "save_vector": "Vector/CAA/refusal",
    "train_dataset": "refusal_caa",
    "n_train": 1000
  },
  "steer": {
    "method": "CAA",
    "layer": 18,
    "coeff": 1.0,
    "apply_chat_template": false,
    "hook_point": "post",
    "load_vector": "Vector/CAA/refusal",
    "n_test": 1000
  },
  "test_dataset": "donotanswer",
  "output": "./Results/caa",
  "include_baseline": false,
  "seed": 42
}