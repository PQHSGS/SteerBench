{
  "name": "qwen_xstest",
  "description": "CAA steering trained on sycophancy, evaluated on corrigible",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 18,
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "CAA",
    "layer": 18,
    "coeff": 3.0,
    "apply_chat_template": true,
    "hook_point": "pre",
    "n_test": 1000
  },
  "load_vector": "Vector/CAA/Qwen/ai_risk_refusal",
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "test_dataset": "xstest",
  "output": "./Results/caa",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}