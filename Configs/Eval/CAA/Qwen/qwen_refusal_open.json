{
  "name": "qwen_refusal_open",
  "description": "CAA steering trained on refusal, evaluated on refusal_open",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 18,
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "CAA",
    "layer": 18,
    "coeff": 1.0,
    "apply_chat_template": true,
    "hook_point": "pre"
  },
  "load_vector": "Vector/CAA/Qwen/ai_risk_refusal",
  "test_dataset": "refusal_open",
  "output": "./Results/caa",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42
}