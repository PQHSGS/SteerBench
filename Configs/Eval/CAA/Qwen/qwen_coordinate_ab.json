{
  "name": "qwen_coordinate_ab",
  "description": "CAA steering trained on coordinate, evaluated on coordinate_ab",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 18,
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "CAA",
    "layer": 18,
    "coeff": 1.0,
    "apply_chat_template": true,
    "hook_point": "pre"
  },
  "train_dataset": "ai_risk_coordinate",
  "n_train": 360,
  "n_test": 500,
  "save_vector": "Vector/CAA/Qwen/ai_risk_coordinate",
  "test_dataset": "coordinate_ab",
  "output": "./Results/caa",
  "seed": 42
}