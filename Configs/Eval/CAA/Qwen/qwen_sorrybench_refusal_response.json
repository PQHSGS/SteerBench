{
  "name": "qwen_sorrybench_refusal_response",
  "description": "CAA steering using refusal_response vector, evaluated on SorryBench",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAA",
    "layer": 18,
    "batch_size": 4,
    "position": -1,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "CAA",
    "layer": 18,
    "coeff": 1.0,
    "apply_chat_template": true,
    "hook_point": "pre"
  },
  "load_vector": "Vector/CAA/Qwen/refusal_response",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/caa",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}