{
  "name": "qwen_deception_baseline",
  "description": "CAA deception steering evaluated on deception (baseline)",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": true,
    "method": "CAA",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "ot_steer": false,
    "position": "mask"
  },
  "steer": {
    "method": "CAA",
    "layer": 18,
    "coeff": 0,
    "apply_chat_template": true,
    "hook_point": "pre",
    "steer_once": true,
    "ot_steer": false
  },
  "save_vector": "Vector/CAA/Qwen/deception",
  "train_dataset": "liarbench",
  "test_dataset": "liarbench",
  "output": "./Results/caa",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "n_test": 100
}