{
  "name": "llama_gms8k",
  "description": "CAA steering trained on hallucination, evaluated on gms8k",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 300
  },
  "extractor": {
    "method": "CAA",
    "layer": 14,
    "batch_size": 4,
    "position": "last",
    "apply_chat_template": true,
    "train_dataset": "gms8k_train",
    "n_train": null
  },
  "steer": {
    "batch_size": 4,
    "method": "CAA",
    "layer": 14,
    "coeff": 1.0,
    "apply_chat_template": true
  },
  "save_vector": "Vector/CAA/gms8k",
  "train_dataset": "gms8k_train",
  "n_train": 1000,
  "test_dataset": "gms8k",
  "n_test": null,
  "output": "./Results/caa",
  "include_baseline": false,
  "seed": 42
}