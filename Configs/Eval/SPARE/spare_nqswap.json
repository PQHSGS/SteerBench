{
  "name": "spare_nqswap",
  "description": "SPARE steering on NQSwap (Llama-2-7b, Layer 14)",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "float16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SPARE",
    "layer": 14,
    "batch_size": 4,
    "top_k_proportion": 0.07,
    "save_vector": "Vector/SPARE/spare_nqswap_L14",
    "train_dataset": "nqswap_train",
    "n_train": 100
  },
  "steer": {
    "method": "SPARE",
    "layer": 14,
    "coeff": 1.0,
    "target_behavior": "contextual",
    "n_test": 50
  },
  "test_dataset": "nqswap_test",
  "output": "./Results/spare_nqswap"
}
