{
  "name": "llama_refusal_open",
  "description": "SRPS steering trained on refusal_caa, evaluated on SorryBench",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "do_sample": false,
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SPARE",
    "layer": 7,
    "batch_size": 4,
    "position": -2,
    "apply_chat_template": true,
    "top_k_proportion": 0.07,
    "top_k": 15
  },
  "steer": {
    "method": "SPARE",
    "layer": 7,
    "coeff": 10,
    "batch_size": 8,
    "apply_chat_template": true,
    "target_behavior": "contextual",
    "top_k": 5
  },
  "load_vector": "Vector/SPARE/Llama/ai_risk_refusal",
  "n_test": null,
  "train_dataset": "refusal_caa",
  "test_dataset": "refusal_open",
  "output": "./Results/spare",
  "include_baseline": false,
  "compute_perplexity": true
}