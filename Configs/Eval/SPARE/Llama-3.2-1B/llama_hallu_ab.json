{
  "name": "llama_hallu_ab",
  "description": "SRPS steering trained on hallucination, evaluated on hallucination_ab",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "do_sample": false,
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SPARE",
    "layer": 7,
    "batch_size": 4,
    "position": -2,
    "apply_chat_template": true,
    "top_k_proportion": 0.07,
    "top_k": 15
  },
  "steer": {
    "method": "SPARE",
    "layer": 7,
    "coeff": 2.0,
    "batch_size": 4,
    "position": "all",
    "apply_chat_template": true,
    "target_behavior": "parametric",
    "top_k": 5
  },
  "load_vector": "Vector/SPARE/Llama/ai_risk_hallucination",
  "train_dataset": "hallucination",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "hallucination_ab",
  "output": "./Results/spare",
  "include_baseline": false
}