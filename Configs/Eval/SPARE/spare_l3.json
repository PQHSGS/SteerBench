{
  "name": "gemma_nqswap",
  "description": "Level 3: SPARE - EXACT match with GT: scripts/run_spare.py --model_path=google/gemma-2-2b-it --data_name=nqswap",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100,
    "do_sample": false
  },
  "extractor": {
    "method": "SPARE",
    "layer": [
      14,
      15,
      16
    ],
    "batch_size": 4,
    "apply_chat_template": false,
    "top_k_proportion": 0.07
  },
  "steer": {
    "method": "SPARE",
    "layer": [
      14,
      15,
      16
    ],
    "coeff": 1.0,
    "batch_size": 4,
    "apply_chat_template": false,
    "target_behavior": "contextual"
  },
  "load_vector": "Vector/SPARE/spare_nqswap",
  "train_dataset": "nqswap_train",
  "n_train": 1000,
  "test_dataset": "nqswap_test",
  "n_test": 20,
  "include_baseline": true,
  "output": "./Results/spare"
}
