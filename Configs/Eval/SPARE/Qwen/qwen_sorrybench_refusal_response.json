{
  "name": "qwen_sorrybench_refusal_response",
  "description": "SPARE steering for sorrybench_refusal_response",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "do_sample": false,
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SPARE",
    "layer": 18,
    "batch_size": 4,
    "apply_chat_template": true,
    "top_k_proportion": 0.07,
    "top_k": 15
  },
  "steer": {
    "method": "SPARE",
    "layer": 18,
    "coeff": 1.0,
    "batch_size": 4,
    "apply_chat_template": true,
    "target_behavior": "contextual",
    "top_k": 5
  },
  "load_vector": "Vector/SPARE/Qwen/refusal_response",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/spare",
  "include_baseline": false,
  "compute_perplexity": true,
  "train_dataset": "sorrybench_refusal_response",
  "seed": 42
}