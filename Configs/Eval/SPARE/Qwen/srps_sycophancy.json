{
  "name": "srps_sycophancy",
  "description": "SRPS (Semantic-Robust Prompt Steering) - uses beta for activation/active-dimension balance",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": [
      29
    ],
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 0.2,
    "position": -2,
    "beta": 5,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SRPS",
    "layer": [
      29
    ],
    "coeff": 1.0,
    "apply_chat_template": true,
    "top_k": 5
  },
  "save_vector": "Vector/SRPS/sycophancy",
  "test_dataset": "sycophancy_ab",
  "output": "./Results/srps",
  "train_dataset": "sycophancy",
  "n_train": 1000,
  "n_test": null,
  "include_baseline": false
}