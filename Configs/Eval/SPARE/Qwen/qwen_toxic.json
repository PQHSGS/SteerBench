{
  "name": "qwen_toxic",
  "description": "SPARE toxic steering evaluated on toxic",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "do_sample": false,
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": false,
    "method": "SPARE",
    "layer": 18,
    "batch_size": 4,
    "apply_chat_template": true,
    "top_k_proportion": 0.07,
    "top_k": 15
  },
  "steer": {
    "method": "SPARE",
    "layer": 18,
    "coeff": 3.0,
    "batch_size": 4,
    "apply_chat_template": true,
    "target_behavior": "contextual",
    "top_k": 5
  },
  "train_dataset": "toxic_jigsaw",
  "n_test": 100,
  "n_train": 500,
  "test_dataset": "toxic",
  "output": "./Results/spare",
  "include_baseline": false,
  "compute_perplexity": true,
  "save_vector": "Vector/SPARE/Qwen/toxic",
  "seed": 42
}