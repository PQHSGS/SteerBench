{
  "name": "llama_xstest",
  "description": "SRPS steering trained on refusal_caa, evaluated on xstest (over-refusal benchmark)",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SPARE",
    "layer": 17,
    "batch_size": 4,
    "position": -2,
    "apply_chat_template": true,
    "top_k_proportion": 0.07
  },
  "steer": {
    "method": "SPARE",
    "layer": 17,
    "coeff": 1.0,
    "batch_size": 4,
    "apply_chat_template": true,
    "target_behavior": "contextual"
  },
  "load_vector": "Vector/SPARE/Llama/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "xstest",
  "output": "./Results/spare",
  "include_baseline": true,
  "compute_perplexity": true
}
