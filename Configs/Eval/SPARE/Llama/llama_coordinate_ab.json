{
  "name": "llama_coordinate_ab",
  "description": "SRPS steering trained on ai_risk_coordinate, evaluated on coordinate_ab",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SPARE",
    "layer": 17,
    "batch_size": 4,
    "position": -2,
    "apply_chat_template": true,
    "top_k_proportion": 0.07
  },
  "steer": {
    "method": "SPARE",
    "layer": 17,
    "coeff": 1.0,
    "apply_chat_template": true,
    "target_behavior": "contextual"
  },
  "save_vector": "Vector/SPARE/Llama/ai_risk_coordinate",
  "train_dataset": "ai_risk_coordinate",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "coordinate_ab",
  "output": "./Results/spare",
  "include_baseline": true
}
