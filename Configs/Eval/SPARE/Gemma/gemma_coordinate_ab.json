{
  "name": "gemma_coordinate_ab",
  "description": "SRPS steering trained on ai_risk_coordinate, evaluated on coordinate_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "do_sample": false,
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SPARE",
    "layer": 14,
    "batch_size": 4,
    "position": -2,
    "apply_chat_template": true,
    "top_k_proportion": 0.07
  },
  "steer": {
    "method": "SPARE",
    "layer": 14,
    "coeff": 1.0,
    "batch_size": 4,
    "apply_chat_template": true,
    "target_behavior": "contextual",
    "top_k": 5
  },
  "load_vector": "Vector/SPARE/Gemma/ai_risk_coordinate",
  "train_dataset": "ai_risk_coordinate",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "coordinate_ab",
  "output": "./Results/spare",
  "include_baseline": false
}
