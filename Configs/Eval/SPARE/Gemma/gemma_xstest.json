{
  "name": "gemma_xstest",
  "description": "SRPS steering trained on refusal_caa, evaluated on xstest (over-refusal benchmark)",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "do_sample": false,
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SPARE",
    "layer": 14,
    "batch_size": 4,
    "apply_chat_template": true,
    "top_k_proportion": 0.07
  },
  "steer": {
    "method": "SPARE",
    "layer": 14,
    "coeff": 1.0,
    "batch_size": 4,
    "apply_chat_template": true,
    "target_behavior": "contextual",
    "top_k": 5
  },
  "load_vector": "Vector/SPARE/Gemma/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "xstest",
  "output": "./Results/spare",
  "include_baseline": false,
  "compute_perplexity": true
}
