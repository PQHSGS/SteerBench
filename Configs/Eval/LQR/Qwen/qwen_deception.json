{
  "name": "qwen_deception",
  "description": "LQR deception steering extraction/eval (gemma-2-2b-it)",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "LQR",
    "layer": [
      18
    ],
    "batch_size": 4,
    "hook_point": "pre",
    "position": "last",
    "inverse": true,
    "apply_chat_template": true,
    "lqr_Q": 1.0,
    "lqr_R": 1.0,
    "lqr_Qf": 1.0,
    "lqr_jac_chunk_size": 64,
    "lqr_store_jacobians": false
  },
  "steer": {
    "method": "LQR",
    "layer": [
      18
    ],
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 2.0,
    "steer_once": false
  },
  "train_dataset": "liarbench",
  "n_train": 500,
  "test_dataset": "liarbench",
  "n_test": 100,
  "save_vector": "Vector/LQR/Qwen/deception",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "output": "./Results/lqr"
}