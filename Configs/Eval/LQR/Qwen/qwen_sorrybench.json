{
  "name": "qwen_sorrybench",
  "description": "LQR refusal steering eval on sorrybench (gemma-2-2b-it)",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "LQR",
    "layer": [
      18
    ],
    "batch_size": 4,
    "hook_point": "pre",
    "position": -2,
    "apply_chat_template": true,
    "lqr_Q": 1.0,
    "lqr_R": 1.0,
    "lqr_Qf": 1.0,
    "lqr_jac_chunk_size": 64,
    "lqr_store_jacobians": false
  },
  "steer": {
    "method": "LQR",
    "layer": [
      18
    ],
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": -2,
    "coeff": 1.0,
    "batch_size": 4
  },
  "load_vector": "Vector/LQR/Qwen/ai_risk_refusal",
  "test_dataset": "sorrybench",
  "n_test": null,
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "output": "./Results/lqr"
}