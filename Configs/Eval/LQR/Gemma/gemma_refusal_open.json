{
  "name": "gemma_refusal_open",
  "description": "LQR refusal steering eval on open prompts (gemma-2-2b-it)",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "LQR",
    "layer": [14],
    "batch_size": 4,
    "hook_point": "pre",
    "position": -2,
    "apply_chat_template": true,
    "lqr_Q": 1.0,
    "lqr_R": 1.0,
    "lqr_Qf": 1.0,
    "lqr_jac_chunk_size": 64,
    "lqr_store_jacobians": false
  },
  "steer": {
    "method": "LQR",
    "layer": [14],
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": -2,
    "coeff": 1.0
  },
  "load_vector": "Vector/LQR/Gemma/ai_risk_refusal",
  "test_dataset": "refusal_open",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "output": "./Results/lqr"
}
