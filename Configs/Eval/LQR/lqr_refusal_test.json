{
  "name": "lqr_refusal_test",
  "description": "A-LQR steering for refusal on gemma-2-2b-it (quick test)",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 64,
    "do_sample": false
  },
  "extractor": {
    "method": "LQR",
    "layer": [6, 8, 10, 12, 14, 16],
    "hook_point": "pre",
    "position": "last",
    "batch_size": 4,
    "lqr_Q": 1.0,
    "lqr_R": 1.0,
    "lqr_Qf": 1.0,
    "lqr_jac_chunk_size": 64,
    "lqr_store_jacobians": false
  },
  "steer": {
    "method": "LQR",
    "layer": [6, 8, 10, 12, 14, 16],
    "hook_point": "pre",
    "position": "last",
    "coeff": 1.0,
    "batch_size": 4,
    "norm": false
  },
  "train_dataset": "refusal",
  "test_dataset": "refusal",
  "n_train": 8,
  "n_test": 4,
  "save_vector": "Results/NewMethods/lqr_refusal_test_vector"
}
