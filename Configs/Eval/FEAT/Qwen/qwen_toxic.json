{
  "name": "qwen_toxic",
  "description": "FEAT toxic steering evaluated on toxic",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": false,
    "method": "SAEIO",
    "layer": [
      18
    ],
    "batch_size": 4,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "act_threshold": 10000
  },
  "steer": {
    "method": "FEAT",
    "layer": [
      18
    ],
    "coeff": 1,
    "feature_list": [
      13510
    ],
    "overwrite_with_max_act": true,
    "max_act": 150.0,
    "use_reconstruction_error": true,
    "hook_point": "pre",
    "position": "last",
    "steer_once": true
  },
  "n_test": 100,
  "test_dataset": "toxic",
  "train_dataset": "toxic_extreme",
  "n_train": 1,
  "output": "./Results/feat",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "save_vector": "Vector/FEAT/Qwen/toxic"
}