{
  "name": "gemma_evil",
  "description": "SAEIO evil steering evaluated on evil",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "batch_size": 4,
    "apply_chat_template": true,
    "hook_point": "pre",
    "act_threshold": 10000,
    "inverse": false
  },
  "steer": {
    "method": "FEAT",
    "layer": [
      14
    ],
    "coeff": 1,
    "feature_list": [
      11069
    ],
    "overwrite_with_max_act": true,
    "max_act": 80.0,
    "use_reconstruction_error": true,
    "hook_point": "pre",
    "steer_once": true
  },
  "n_test": 100,
  "test_dataset": "evil",
  "train_dataset": "evil",
  "n_train": 500,
  "output": "./Results/feat",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "save_vector": "Vector/FEAT/Gemma/evil"
}