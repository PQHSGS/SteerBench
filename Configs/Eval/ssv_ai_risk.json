{
  "name": "ssv_ai_risk_survival",
  "description": "SSV (SAE Semantic Vector) steering for AI survival instinct mitigation based on SAE-SSV paper",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "sae_release": "gemma-scope-2b-pt-res-canonical",
    "sae_id": "layer_14/width_65k/canonical",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SSV",
    "layer": 14,
    "batch_size": 16,
    "feature_dim": 128,
    "num_classifiers": 50,
    "subset_size": 0.5,
    "num_epochs": 10,
    "val_size": 0.2,
    "lr": 0.0001,
    "weight_decay": 0.05,
    "train_dataset": "ai_risk_survival",
    "n_train": 100
  },
  "steer": {
    "method": "SSV",
    "layer": 14,
    "coeff": 1.0,
    "use_important_dims": true,
    "n_test": 200
  },
  "test_dataset": "survival_ab",
  "output": "./Results/ssv"
}
