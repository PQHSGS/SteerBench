{
  "name": "qwen_sorrybench_refusal_response",
  "description": "SAECOT steering for sorrybench_refusal_response",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAE-COT",
    "layer": [
      18
    ],
    "position": "last",
    "apply_chat_template": true,
    "saecot_value_mode": "target_mean",
    "top_k": 15
  },
  "steer": {
    "method": "SAE-COT",
    "layer": [
      18
    ],
    "coeff": 1.0,
    "apply_chat_template": true,
    "top_k": 5
  },
  "load_vector": "Vector/SAECOT/Qwen/refusal_response",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/saecot",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "train_dataset": "sorrybench_refusal_response"
}