{
  "name": "gemma_refusal_ab",
  "description": "SAECOT steering for refusal_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAE-COT",
    "layer": [
      14
    ],
    "batch_size": 4,
    "position": -2,
    "apply_chat_template": true,
    "saecot_value_mode": "target_mean",
    "top_k": 15
  },
  "steer": {
    "method": "SAE-COT",
    "layer": [
      14
    ],
    "coeff": 1.0,
    "apply_chat_template": true,
    "top_k": 5,
    "position": "last"
  },
  "save_vector": "Vector/SAECOT/Gemma/ai_risk_refusal",
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "refusal_ab",
  "output": "./Results/saecot",
  "include_baseline": false,
  "seed": 42
}