{
  "name": "llama_refusal_open",
  "description": "SAE-COT steering using refusal vector, evaluated on refusal_open",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAE-COT",
    "layer": [
      7
    ],
    "batch_size": 4,
    "position": -2,
    "apply_chat_template": true,
    "saecot_value_mode": "target_mean",
    "top_k": 15
  },
  "steer": {
    "method": "SAE-COT",
    "layer": [
      7
    ],
    "coeff": 1.0,
    "apply_chat_template": true,
    "top_k": 5
  },
  "save_vector": "Vector/SAECOT/Llama/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "refusal_open",
  "train_dataset": "refusal_caa",
  "output": "./Results/saecot",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}