{
  "name": "gemma_sorrybench",
  "description": "MANIFOLD steering for sorrybench",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "MANIFOLD",
    "layer": [
      14
    ],
    "batch_size": 4,
    "position": "last",
    "hook_point": "pre",
    "apply_chat_template": true,
    "manifold_dim": 10
  },
  "steer": {
    "method": "MANIFOLD",
    "layer": [
      14
    ],
    "coeff": 0.3,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "apply_all_layers": false
  },
  "load_vector": "Vector/MANIFOLD/Gemma/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/manifold",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "train_dataset": "sorrybench_refusal_response",
  "n_train": 1000
}