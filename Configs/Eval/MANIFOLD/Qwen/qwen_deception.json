{
  "name": "qwen_deception",
  "description": "MANIFOLD steering for deception",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": true,
    "method": "MANIFOLD",
    "layer": [
      18
    ],
    "batch_size": 4,
    "position": "last",
    "hook_point": "pre",
    "apply_chat_template": true,
    "manifold_dim": 32
  },
  "steer": {
    "method": "MANIFOLD",
    "layer": [
      18
    ],
    "coeff": 0.3,
    "hook_point": "pre",
    "apply_chat_template": true,
    "apply_all_layers": false
  },
  "save_vector": "Vector/MANIFOLD/Qwen/deception",
  "n_test": 100,
  "test_dataset": "liarbench",
  "train_dataset": "liarbench",
  "output": "./Results/manifold",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}