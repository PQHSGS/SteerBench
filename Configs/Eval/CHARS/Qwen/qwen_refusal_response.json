{
  "name": "qwen_refusal_response",
  "description": "CHARS steering on refusal_response",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CHARS",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "chars_k": 30,
    "chars_lambda": 0.1
  },
  "steer": {
    "method": "CHARS",
    "layer": 18,
    "apply_chat_template": true,
    "hook_point": "pre",
    "coeff": 1.0,
    "steer_once": false
  },
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "refusal_open",
  "save_vector": "Vector/CHARS/Qwen/refusal_response",
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/chars",
  "seed": 42
}