{
  "name": "qwen_refusal_ab",
  "description": "CHARS steering on refusal_ab",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CHARS",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "position": -2
  },
  "steer": {
    "method": "CHARS",
    "layer": 18,
    "apply_chat_template": true,
    "hook_point": "pre",
    "coeff": 2.0
  },
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "test_dataset": "refusal_ab",
  "save_vector": "Vector/CHARS/Qwen/ai_risk_refusal",
  "output": "./Results/chars",
  "seed": 42
}