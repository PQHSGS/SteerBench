{
  "name": "qwen_evil_evil_diag",
  "description": "CHARS evil_diag on evil",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CHARS",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "position": "mask",
    "inverse": false,
    "chars_k": 10,
    "chars_lambda": 0.1,
    "chars_diag": true
  },
  "steer": {
    "method": "CHARS",
    "layer": 18,
    "apply_chat_template": true,
    "hook_point": "pre",
    "coeff": 2.0,
    "steer_once": false,
    "chars_diag": true
  },
  "test_dataset": "evil",
  "n_test": 100,
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/chars",
  "seed": 42,
  "train_dataset": "evil",
  "n_train": 500,
  "save_vector": "Vector/CHARS/Qwen/evil_diag"
}