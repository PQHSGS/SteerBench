{
  "name": "gemma_refusal_response",
  "description": "CHARS steering on refusal_response",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:2",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CHARS",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "chars_k": 30,
    "chars_lambda": 0.1
  },
  "steer": {
    "method": "CHARS",
    "layer": 14,
    "apply_chat_template": true,
    "hook_point": "pre",
    "coeff": 1.0,
    "steer_once": false
  },
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "refusal_open",
  "save_vector": "Vector/CHARS/Gemma/refusal_response",
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/chars",
  "seed": 42
}