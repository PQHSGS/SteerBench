{
  "name": "gemma_toxic",
  "description": "CHARS toxic steering evaluated on toxic",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:3",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CHARS",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "inverse": false,
    "chars_k": 50,
    "chars_lambda": 0.1
  },
  "steer": {
    "method": "CHARS",
    "layer": 14,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 5,
    "steer_once": false
  },
  "train_dataset": "toxic_jigsaw",
  "test_dataset": "toxic",
  "load_vector": "Vector/CHARS/Gemma/toxic",
  "n_test": 100,
  "n_train": 500,
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/chars",
  "seed": 42
}