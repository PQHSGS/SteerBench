{
  "name": "gemma_evil_flm",
  "description": "FLOW+LM evil steering evaluated on evil",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:4",
    "dtype": "bfloat16",
    "max_new_tokens": 128,
    "do_sample": false
  },
  "extractor": {
    "method": "FLOW",
    "inverse": true,
    "layer": [14],
    "batch_size": 16,
    "position": "mask",
    "apply_chat_template": true,
    "hook_point": "pre",
    "change_pad_token": false,
    "flow_hidden_dim": 256,
    "flow_layers": 2,
    "flow_lr": 0.001,
    "flow_epochs": 400,
    "flow_batch_size": 64,
    "flow_seed": 42,
    "flow_subspace_dim": 64,
    "flow_norm_mode": "gaussian",
    "flow_loss_mode": "mse",
    "flow_weighted": false,
    "flow_train_space": "pca_diff",
    "flow_target_type": "concept",
    "flow_lm_loss": true,
    "flow_lm_lambda": 0.1,
    "flow_lm_lr": 2e-4,
    "flow_lm_epochs": 10,
    "flow_lm_grad_accum": 4,
    "flow_lm_batch_size": 4, 
    "flow_max_new_tokens": 30
  },
  "steer": {
    "method": "FLOW",
    "layer": [14],
    "coeff": 1,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "batch_size": 4,
    "norm": false,
    "apply_all_layers": false,
    "flow_steps": 16,
    "flow_guidance_strength": 0.0,
    "flow_guidance_mode": "off",
    "flow_denoise_mode": "proj",
    "steer_once": false
  },
  "post_process": {},
  "save_vector": "Vector/FlowLM/Gemma/evil",
  "train_dataset": "evil",
  "n_train": 500,
  "test_dataset": "evil",
  "n_test": 100,
  "output": "Results/FlowLM",
  "include_baseline": false,
  "compute_perplexity": true,
  "save_samples": false,
  "seed": 42
}
