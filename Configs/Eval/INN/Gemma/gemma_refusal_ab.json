{
  "name": "gemma_refusal_ab",
  "description": "INN steering on refusal_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "INNSTEER",
    "layer": [14],
    "batch_size": 4,
    "hook_point": "pre",
    "position": -2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "INNSTEER",
    "layer": [14],
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 2.0
  },
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "test_dataset": "refusal_ab",
  "save_vector": "Vector/INN/Gemma/ai_risk_refusal",
  "output": "./Results/inn",
  "seed": 42
}
