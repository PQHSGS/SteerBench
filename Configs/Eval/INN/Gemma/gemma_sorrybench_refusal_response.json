{
  "name": "gemma_sorrybench_refusal_response",
  "description": "INN steering on sorrybench_refusal_response",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "INNSTEER",
    "layer": [14],
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true
  },
  "steer": {
    "method": "INNSTEER",
    "layer": [14],
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 1.0
  },
  "load_vector": "Vector/INN/Gemma/refusal_response",
  "test_dataset": "sorrybench",
  "n_test": null,
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/inn",
  "seed": 42
}
