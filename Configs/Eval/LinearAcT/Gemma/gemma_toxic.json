{
  "name": "gemma_toxic",
  "description": "LinearAcT toxic steering evaluated on toxic",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100,
    "do_sample": false
  },
  "extractor": {
    "inverse": false,
    "method": "ACT",
    "layer": [
      14
    ],
    "hook_point": "pre",
    "position": "mask",
    "batch_size": 4,
    "act_mode": "linear"
  },
  "steer": {
    "method": "ACT",
    "layer": [
      14
    ],
    "hook_point": "pre",
    "position": "last",
    "coeff": 2,
    "batch_size": 4,
    "apply_chat_template": false,
    "act_support": "none"
  },
  "train_dataset": "toxic_jigsaw",
  "test_dataset": "toxic",
  "n_train": 500,
  "n_test": 100,
  "output": "./Results/linearact",
  "compute_perplexity": true,
  "save_vector": "Vector/LinearAcT/Gemma/toxic",
  "include_baseline": false,
  "seed": 42
}