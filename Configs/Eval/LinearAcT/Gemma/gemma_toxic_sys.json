{
  "name": "gemma_toxic_sys",
  "description": "ACT toxic with system prompt",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "ACT",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true
  },
  "steer": {
    "method": "ACT",
    "layer": 14,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 5,
    "batch_size": 4
  },
  "load_vector": "Vector/LinearAcT/Gemma/toxic",
  "train_dataset": null,
  "test_dataset": "toxic_with_sys",
  "n_test": 20,
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/linearact_sys",
  "seed": 42
}
