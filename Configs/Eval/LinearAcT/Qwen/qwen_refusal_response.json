{
  "name": "qwen_refusal_response",
  "description": "LINEARACT steering for refusal_response",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100,
    "do_sample": false
  },
  "extractor": {
    "method": "ACT",
    "layer": [
      18
    ],
    "hook_point": "pre",
    "position": "last",
    "batch_size": 4,
    "act_mode": "linear"
  },
  "steer": {
    "method": "ACT",
    "layer": [
      18
    ],
    "hook_point": "pre",
    "position": "last",
    "coeff": 0.7,
    "batch_size": 4,
    "apply_all_layers": false,
    "apply_chat_template": true,
    "act_support": "none"
  },
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "refusal_open",
  "n_train": null,
  "n_test": null,
  "output": "./Results/linearact",
  "compute_perplexity": true,
  "load_vector": "Vector/LinearAcT/Qwen/refusal_response",
  "include_baseline": false,
  "seed": 42
}