{
  "name": "qwen_evil_sys",
  "description": "ACT evil with system prompt",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "ACT",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true
  },
  "steer": {
    "method": "ACT",
    "layer": 18,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 5,
    "batch_size": 4
  },
  "load_vector": "Vector/LinearAcT/Qwen/evil",
  "train_dataset": null,
  "test_dataset": "evil_with_sys",
  "n_test": 20,
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/linearact_sys",
  "seed": 42
}