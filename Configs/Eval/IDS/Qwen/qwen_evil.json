{
  "name": "qwen_evil",
  "description": "IDS evil steering evaluated on evil",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "IDS",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "inverse": false,
    "position": "mask",
    "ids_var_explained": 0.4,
    "ids_epsilon_pct": 0.95,
    "ids_f1_threshold": 0.7
  },
  "steer": {
    "method": "IDS",
    "layer": 18,
    "coeff": 1.0,
    "apply_chat_template": true,
    "hook_point": "pre",
    "steer_once": false,
    "ids_f1_threshold": 0.7
  },
  "save_vector": "./Results/ids/vector/evil",
  "train_dataset": "evil",
  "test_dataset": "evil",
  "output": "./Results/ids",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "n_test": 100,
  "n_train": 500
}