{
  "name": "gemma_hallu_ab",
  "description": "COLD steering for hallu_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100,
    "do_sample": false
  },
  "extractor": {
    "method": "COLD",
    "layer": [
      14
    ],
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "apply_chat_template": false,
    "cold_variant": "fd",
    "cold_eta": 1.0,
    "cold_epsilon": 1e-06,
    "cold_pair_margin": 0.0
  },
  "steer": {
    "method": "COLD",
    "layer": [
      14
    ],
    "coeff": 1.0,
    "hook_point": "pre",
    "position": -2,
    "apply_chat_template": false
  },
  "train_dataset": "hallucination",
  "test_dataset": "hallucination_ab",
  "n_train": null,
  "n_test": 500,
  "seed": 42,
  "output": "./Results/cold",
  "save_vector": "Vector/COLD/Gemma/ai_risk_hallucination",
  "include_baseline": false
}