{
  "name": "gemma_toxic",
  "description": "PCAOT steering on toxic",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "ACT",
    "layer": [14],
    "batch_size": 4,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "act_mode": "pca_ot",
    "pca_components": 4,
    "inverse": false
  },
  "steer": {
    "method": "ACT",
    "layer": [14],
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 1.0,
    "steer_once": false
  },
  "train_dataset": "toxic_jigsaw",
  "n_train": 500,
  "test_dataset": "toxic",
  "n_test": 100,
  "save_vector": "Vector/PCAOT/Gemma/toxic",
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/pcaot",
  "seed": 42
}
