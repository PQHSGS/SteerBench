{
  "name": "qwen_hallu_ab",
  "description": "PCAOT steering on hallu_ab",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "ACT",
    "layer": [
      18
    ],
    "batch_size": 4,
    "hook_point": "pre",
    "position": -2,
    "apply_chat_template": true,
    "act_mode": "pca_ot"
  },
  "steer": {
    "method": "ACT",
    "layer": [
      18
    ],
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 1.0
  },
  "train_dataset": "hallucination",
  "n_train": 1000,
  "test_dataset": "hallucination_ab",
  "n_test": 500,
  "save_vector": "Vector/PCAOT/Qwen/ai_risk_hallucination",
  "output": "./Results/pcaot",
  "seed": 42
}