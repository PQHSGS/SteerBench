{
  "name": "truthflow_refusal_cast_gemma2b",
  "description": "TruthFlow pipeline config for Gemma 2B on refusal_cast_responses, aligned to the paper's query-specific correction + SVD projection setup.",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 128,
    "do_sample": false
  },
  "extractor": {
    "method": "FLOW",
    "layer": [14],
    "batch_size": 16,
    "position": "last",
    "apply_chat_template": true,
    "hook_point": "pre",
    "change_pad_token": false,
    "flow_hidden_dim": 1152,
    "flow_layers": 4,
    "flow_lr": 0.0001,
    "flow_epochs": 200,
    "flow_batch_size": 32,
    "flow_seed": 42,
    "flow_subspace_dim": 16,
    "flow_subspace_mode": "stack",
    "flow_norm_mode": "gaussian",
    "flow_loss_mode": "mse",
    "flow_weighted": false,
    "flow_train_space": "full",
    "flow_target_type": "correction"
  },
  "steer": {
    "method": "FLOW",
    "layer": [14],
    "coeff": 1,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "batch_size": 4,
    "norm": false,
    "apply_all_layers": false,
    "flow_steps": 5,
    "flow_guidance_strength": 0.0,
    "flow_guidance_mode": "off",
    "flow_denoise_mode": "correction"
  },
  "post_process": {},
  "train_dataset": "refusal_cast_responses",
  "n_train": null,
  "test_dataset": "refusal_open",
  "n_test": null,
  "output": "Results/TruthFlow",
  "save_samples": false,
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "save_vector": "Vector/TruthFlow/refusal_response"
}
