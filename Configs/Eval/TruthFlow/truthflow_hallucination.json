{
  "name": "truthflow_hallucination",
  "description": "TruthFlow query-specific correction vectors from correct-vs-incorrect answer pairs, configured to mirror the paper's flow-matching and SVD-projection recipe.",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 128,
    "do_sample": false
  },
  "extractor": {
    "method": "FLOW",
    "layer": [
      7
    ],
    "hook_point": "post",
    "position": "last",
    "batch_size": 4,
    "flow_hidden_dim": 1024,
    "flow_layers": 4,
    "flow_epochs": 25,
    "flow_batch_size": 136,
    "flow_lr": 0.0001,
    "flow_seed": 42,
    "flow_subspace_dim": 20,
    "flow_subspace_mode": "diff",
    "flow_norm_mode": "gaussian",
    "flow_loss_mode": "mse",
    "flow_weighted": false,
    "flow_train_space": "full",
    "flow_target_type": "correction"
  },
  "steer": {
    "method": "FLOW",
    "layer": [
      7
    ],
    "hook_point": "post",
    "position": "all",
    "coeff": 1.0,
    "flow_steps": 16,
    "batch_size": 4,
    "flow_denoise_mode": "correction"
  },
  "train_dataset": "hallucination",
  "test_dataset": "csqa",
  "n_train": null,
  "n_test": null,
  "save_vector": "Results/NewMethods/truthflow_hallucination_vector"
}