{
  "name": "gemma_flas_gms8k",
  "description": "Optimized FLAS pipeline config for Gemma 2B on gms8k math reasoning with low-coeff gentle steering and low epochs to prevent overfitting.",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 300,
    "do_sample": false
  },
  "extractor": {
    "method": "FLAS",
    "layer": [
      14
    ],
    "batch_size": 16,
    "position": "last",
    "apply_chat_template": false,
    "hook_point": "pre",
    "change_pad_token": false,
    "flas_checkpoint_path": null,
    "flas_num_blocks": 2,
    "flas_time_conditioned": true,
    "flas_disable_cross_attn": false,
    "flas_disable_self_attn": false,
    "flas_disable_mlp": false,
    "flas_strict_load": true,
    "flas_concept_encoder_layers": 2,
    "flas_train_concept_text": "highly accurate, logical, step-by-step mathematical reasoning, arithmetic calculations, and grade school math problem-solving",
    "flas_train_lr": 5e-05,
    "flas_train_enc_lr": 1e-05,
    "flas_train_div_weight": 0.1,
    "flas_train_epochs": 5,
    "flas_train_batch_size": 8,
    "flas_train_grad_accum": 4,
    "flas_train_max_len": 256,
    "flas_train_concept_max_len": 64,
    "flas_train_T_min": 0.5,
    "flas_train_T_max": 2.0,
    "flas_train_n_steps": 10,
    "flas_train_seed": 42,
    "flas_train_max_steps": 2000,
    "flas_unfreeze_concept_enc": true,
    "flas_no_gemma_init": false,
    "flas_steer_once": false,
    "inverse": false
  },
  "steer": {
    "method": "FLAS",
    "layer": [
      14
    ],
    "coeff": 0.8,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "batch_size": 4,
    "norm": false,
    "apply_all_layers": false,
    "flas_concept_text": "highly accurate, logical, step-by-step mathematical reasoning, arithmetic calculations, and grade school math problem-solving",
    "flas_concept_max_len": 64,
    "flas_n_steps": 5,
    "flas_max_prompt_len": 512,
    "steer_once": false
  },
  "post_process": {},
  "train_dataset": "gms8k_train_flas",
  "n_train": 1000,
  "test_dataset": "gms8k",
  "n_test": 30,
  "output": "Results/FLAS",
  "save_samples": false,
  "include_baseline": true,
  "compute_perplexity": true,
  "seed": 42,
  "load_vector": null
}