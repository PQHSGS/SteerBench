{
  "name": "qwen_gms8k",
  "description": "CAST steering trained on srps_roleplay_gms8k, evaluated on gms8k",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 300
  },
  "extractor": {
    "method": "CAST",
    "layer": [
      18
    ],
    "batch_size": 4,
    "position": "mask",
    "hook_point": "pre",
    "apply_chat_template": true,
    "use_pca": true
  },
  "steer": {
    "method": "CAST",
    "layer": [
      18
    ],
    "coeff": 1.0,
    "hook_point": "pre",
    "apply_chat_template": true,
    "use_conditional": false,
    "apply_to_all_tokens": false
  },
  "save_vector": "Vector/CAST/Qwen/gms8k",
  "train_dataset": "srps_roleplay_gms8k",
  "n_train": 1000,
  "n_test": 100,
  "test_dataset": "gms8k",
  "output": "./Results/cast",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}