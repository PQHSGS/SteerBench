{
  "name": "qwen_hallu_ab",
  "description": "CAST steering for hallu_ab",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAST",
    "layer": [
      18
    ],
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "apply_chat_template": true,
    "use_pca": true
  },
  "steer": {
    "method": "CAST",
    "layer": [
      18
    ],
    "coeff": 1.0,
    "hook_point": "pre",
    "apply_chat_template": true,
    "use_conditional": false,
    "apply_to_all_tokens": false,
    "position": -2
  },
  "save_vector": "Vector/CAST/Qwen/ai_risk_hallucination",
  "train_dataset": "hallucination",
  "n_train": 1000,
  "n_test": 500,
  "test_dataset": "hallucination_ab",
  "output": "./Results/cast",
  "include_baseline": false,
  "seed": 42
}