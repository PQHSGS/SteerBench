{
  "name": "qwen_toxic",
  "description": "CAST toxic steering evaluated on toxic",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": false,
    "method": "CAST",
    "layer": [
      18
    ],
    "position": "last",
    "hook_point": "pre",
    "apply_chat_template": true,
    "use_pca": true
  },
  "steer": {
    "method": "CAST",
    "layer": [
      18
    ],
    "coeff": 1.0,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "use_conditional": false,
    "apply_to_all_tokens": false
  },
  "save_vector": "Vector/CAST/Qwen/toxic",
  "train_dataset": "toxic_jigsaw",
  "n_test": 100,
  "n_train": 500,
  "test_dataset": "toxic",
  "output": "./Results/cast",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}