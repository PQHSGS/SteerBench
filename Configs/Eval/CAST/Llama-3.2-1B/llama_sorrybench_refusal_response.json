{
  "name": "llama_sorrybench_refusal_response",
  "description": "CAST steering using refusal_response vector, evaluated on SorryBench",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CAST",
    "layer": [
      7
    ],
    "position": -1,
    "hook_point": "pre",
    "apply_chat_template": true,
    "use_pca": false
  },
  "steer": {
    "method": "CAST",
    "layer": [
      7
    ],
    "coeff": 1.0,
    "hook_point": "pre",
    "apply_chat_template": true,
    "use_conditional": false,
    "apply_to_all_tokens": true
  },
  "load_vector": "Vector/CAST/Llama/refusal_response",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/cast",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}