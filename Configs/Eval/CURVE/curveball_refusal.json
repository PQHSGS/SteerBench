{
  "name": "curveball_refusal",
  "description": "Curveball polynomial Kernel-PCA steering for LLM residual activations.",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 128,
    "do_sample": false
  },
  "extractor": {
    "method": "CURVEBALL",
    "layer": [
      7
    ],
    "hook_point": "post",
    "position": "last",
    "batch_size": 4,
    "curveball_dim": 8,
    "curveball_degree": 2,
    "curveball_coef0": 1.0
  },
  "steer": {
    "method": "CURVEBALL",
    "layer": [
      7
    ],
    "hook_point": "post",
    "position": "last",
    "coeff": 1.0,
    "batch_size": 4
  },
  "train_dataset": "refusal",
  "test_dataset": "refusal",
  "n_train": null,
  "n_test": null,
  "save_vector": "Results/NewMethods/curveball_refusal_vector"
}