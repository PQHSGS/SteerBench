{
  "name": "qwen_deception",
  "description": "CURVE steering for deception",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100,
    "do_sample": false
  },
  "extractor": {
    "method": "CURVEBALL",
    "layer": [
      18
    ],
    "batch_size": 4,
    "position": "last",
    "apply_chat_template": true,
    "hook_point": [
      "pre"
    ],
    "change_pad_token": false,
    "inverse": true,
    "curveball_dim": 8,
    "curveball_degree": 2,
    "curveball_coef0": 1.0,
    "curveball_inverse_alpha": 0.001
  },
  "steer": {
    "method": "CURVEBALL",
    "layer": [
      18
    ],
    "coeff": {
      "14": 2
    },
    "apply_chat_template": true,
    "hook_point": [
      "pre"
    ],
    "position": "last",
    "batch_size": 4,
    "norm": true,
    "apply_all_layers": false,
    "steer_once": false
  },
  "train_dataset": "liarbench",
  "test_dataset": "liarbench",
  "n_train": 500,
  "n_test": 100,
  "output": "./Results/curve",
  "compute_perplexity": true,
  "save_vector": "Vector/CURVE/Qwen/deception",
  "load_vector": null,
  "include_baseline": false,
  "seed": 42
}