{
  "name": "qwen_gms8k",
  "description": "Curveball steering setup for Qwen-2-2B-It, evaluated on gms8k.",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 300,
    "do_sample": false
  },
  "extractor": {
    "method": "CURVEBALL",
    "layer": [
      18
    ],
    "hook_point": "pre",
    "position": "mask",
    "batch_size": 4,
    "curveball_dim": 8,
    "curveball_degree": 2,
    "curveball_coef0": 1.0
  },
  "steer": {
    "method": "CURVEBALL",
    "layer": [
      18
    ],
    "hook_point": "pre",
    "position": "last",
    "coeff": 1.0,
    "batch_size": 4
  },
  "train_dataset": "srps_roleplay_gms8k",
  "test_dataset": "gms8k",
  "n_train": 1000,
  "n_test": 100,
  "output": "./Results/curveball",
  "save_vector": "Vector/CURVE/Qwen/gms8k",
  "compute_perplexity": true,
  "include_baseline": false
}