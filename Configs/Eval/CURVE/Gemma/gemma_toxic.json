{
  "name": "gemma_toxic",
  "description": "CURVE toxic steering evaluated on toxic",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:4",
    "dtype": "bfloat16",
    "max_new_tokens": 100,
    "do_sample": false
  },
  "extractor": {
    "inverse": false,
    "method": "CURVEBALL",
    "layer": [
      14
    ],
    "hook_point": "pre",
    "position": "mean",
    "batch_size": 32,
    "curveball_kernel": "rbf",
    "curveball_dim": 8,
    "curveball_degree": 2,
    "curveball_coef0": 1.0
  },
  "steer": {
    "method": "CURVEBALL",
    "layer": [
      14
    ],
    "hook_point": "pre",
    "position": "last",
    "coeff": 3,
    "batch_size": 32,
    "norm": false
  },
  "train_dataset": "toxic_jigsaw",
  "test_dataset": "toxic",
  "n_train": 500,
  "n_test": 100,
  "output": "./Results/curve",
  "compute_perplexity": true,
  "load_vector": "Vector/CURVE/Gemma/toxic",
  "include_baseline": false,
  "seed": 42
}