{
  "name": "gemma_refusal_ab",
  "description": "FGAA steering for refusal_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "FGAA",
    "layer": [
      14
    ],
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "fgaa_density_threshold": 0.01,
    "fgaa_n1": 8,
    "fgaa_n2": 0,
    "fgaa_remove_bos": true,
    "fgaa_l1_normalize_target": true
  },
  "steer": {
    "method": "FGAA",
    "layer": [
      14
    ],
    "coeff": 1.0,
    "hook_point": "pre",
    "position": -2,
    "apply_chat_template": true
  },
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "test_dataset": "refusal_ab",
  "output": "./Results/fgaa",
  "save_vector": "Vector/FGAA/Gemma/ai_risk_refusal",
  "include_baseline": false,
  "seed": 42,
  "n_test": null
}