{
  "name": "qwen_gms8k",
  "description": "FGAA steering setup for Qwen-2-2B-It, evaluated on gms8k.",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 300
  },
  "extractor": {
    "method": "FGAA",
    "layer": [
      18
    ],
    "batch_size": 4,
    "position": "mask",
    "hook_point": "pre",
    "fgaa_density_threshold": 0.01,
    "fgaa_n1": 8,
    "fgaa_n2": 0,
    "fgaa_remove_bos": true,
    "fgaa_l1_normalize_target": true
  },
  "steer": {
    "method": "FGAA",
    "layer": [
      18
    ],
    "coeff": 1.0,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true
  },
  "train_dataset": "srps_roleplay_gms8k",
  "n_train": 1000,
  "test_dataset": "gms8k",
  "n_test": 100,
  "output": "./Results/fgaa",
  "save_vector": "Vector/FGAA/Qwen/gms8k",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}