{
  "name": "qwen_hallu_ab",
  "description": "FGAA steering for hallu_ab",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "FGAA",
    "layer": [
      18
    ],
    "batch_size": 4,
    "position": -2,
    "hook_point": "pre",
    "fgaa_density_threshold": 0.01,
    "fgaa_n1": 8,
    "fgaa_n2": 0,
    "fgaa_remove_bos": true,
    "fgaa_l1_normalize_target": true
  },
  "steer": {
    "method": "FGAA",
    "layer": [
      18
    ],
    "coeff": 1.0,
    "hook_point": "pre",
    "position": -2,
    "apply_chat_template": true
  },
  "train_dataset": "hallucination",
  "n_train": 100,
  "test_dataset": "hallucination_ab",
  "output": "./Results/fgaa",
  "save_vector": "Vector/FGAA/Qwen/ai_risk_hallucination",
  "include_baseline": false,
  "seed": 42,
  "n_test": 500
}