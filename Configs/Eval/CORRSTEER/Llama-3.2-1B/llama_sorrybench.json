{
  "name": "llama_sorrybench",
  "description": "CORRSTEER steering trained on refusal_caa, evaluated on SorryBench",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 7,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 7,
    "coeff": 1.0,
    "top_k": 5
  },
  "load_vector": "Vector/CORRSTEER/Llama/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/corrsteer",
  "include_baseline": false,
  "compute_perplexity": true
}