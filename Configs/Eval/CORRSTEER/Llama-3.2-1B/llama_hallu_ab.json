{
  "name": "llama_hallu_ab",
  "description": "CORRSTEER steering trained on hallucination, evaluated on hallucination_ab",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 7,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "position": -2,
    "apply_chat_template": true,
    "corrsteer_reward_evaluator": "logit",
    "corrsteer_max_new_tokens": 1
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 7,
    "coeff": 1.0,
    "top_k": 5
  },
  "save_vector": "Vector/CORRSTEER/Llama/ai_risk_hallucination",
  "train_dataset": "hallucination",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "hallucination_ab",
  "output": "./Results/corrsteer",
  "include_baseline": false
}