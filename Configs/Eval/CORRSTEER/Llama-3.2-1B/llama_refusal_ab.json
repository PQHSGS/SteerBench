{
  "name": "llama_refusal_ab",
  "description": "CORRSTEER steering trained on refusal_caa, evaluated on refusal_ab",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 7,
    "batch_size": 4,
    "top_k": 15,
    "corrsteer_max_new_tokens": 1,
    "corrsteer_reward_evaluator": "logit",
    "corrsteer_pool": "max",
    "corrsteer_pos_only": true,
    "apply_chat_template": true
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 7,
    "coeff": 1.0,
    "top_k": 5
  },
  "save_vector": "Vector/CORRSTEER/Llama/ai_risk_refusal",
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "refusal_ab",
  "output": "./Results/corrsteer",
  "include_baseline": false
}