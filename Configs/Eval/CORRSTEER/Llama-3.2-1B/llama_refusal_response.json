{
  "name": "llama_refusal_response",
  "description": "CORRSTEER steering trained on refusal_response, evaluated on refusal_open",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 7,
    "batch_size": 4,
    "top_k": 15,
    "corrsteer_max_new_tokens": 30,
    "corrsteer_pool": "max",
    "corrsteer_pos_only": true,
    "apply_chat_template": true,
    "corrsteer_reward_evaluator": "refusal"
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 7,
    "coeff": 1.0,
    "top_k": 5
  },
  "save_vector": "Vector/CORRSTEER/Llama/refusal_response",
  "train_dataset": "refusal_cast_responses",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "refusal_open",
  "output": "./Results/corrsteer",
  "include_baseline": false,
  "compute_perplexity": true
}