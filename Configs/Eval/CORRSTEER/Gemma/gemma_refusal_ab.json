{
  "name": "gemma_refusal_ab",
  "description": "CORRSTEER steering for refusal_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "corrsteer_max_new_tokens": 1,
    "corrsteer_reward_evaluator": "logit",
    "corrsteer_pool": "max",
    "corrsteer_prompt_suffix": "Between A and B, the answer is: (",
    "apply_chat_template": true,
    "position": "last"
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 14,
    "coeff": 1.0,
    "top_k": 5,
    "position": "last"
  },
  "save_vector": "Vector/CORRSTEER/Gemma/ai_risk_refusal",
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "refusal_ab",
  "output": "./Results/corrsteer",
  "include_baseline": false,
  "seed": 42
}