{
  "name": "gemma_gms8k",
  "description": "CORRSTEER steering trained on srps_roleplay_gms8k, evaluated on gms8k",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 300
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 14,
    "batch_size": 4,
    "position": "mask",
    "top_k": 15,
    "corrsteer_max_new_tokens": 1,
    "corrsteer_pool": "max",
    "corrsteer_pos_only": true,
    "apply_chat_template": true,
    "corrsteer_reward_evaluator": "math"
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 14,
    "coeff": 1.0
  },
  "save_vector": "Vector/CORRSTEER/Gemma/gms8k",
  "train_dataset": "srps_roleplay_gms8k",
  "n_train": 1000,
  "n_test": 100,
  "test_dataset": "gms8k",
  "output": "./Results/corrsteer",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}
