{
  "name": "qwen_sycophancy",
  "description": "SAS (SAE-based) steering for hallucination reduction, evaluated on math",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 18,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "position": -2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 18,
    "coeff": 1.0
  },
  "save_vector": "Vector/SAS/sycophancy",
  "train_dataset": "sycophancy",
  "n_train": 1000,
  "n_test": 100,
  "test_dataset": "sycophancy_ab",
  "output": "./Results/sas"
}