{
  "name": "qwen_hallu_ab",
  "description": "CORRSTEER steering for hallu_ab",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 18,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "position": "last",
    "apply_chat_template": true,
    "corrsteer_pool": "max",
    "corrsteer_prompt_suffix": "The answer is: (",
    "corrsteer_reward_evaluator": "logit",
    "corrsteer_max_new_tokens": 1
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 18,
    "coeff": 1.0,
    "top_k": 5,
    "position": "last"
  },
  "save_vector": "Vector/CORRSTEER/Qwen/ai_risk_hallucination",
  "train_dataset": "hallucination",
  "n_train": 1000,
  "n_test": 500,
  "test_dataset": "hallucination_ab",
  "output": "./Results/corrsteer",
  "include_baseline": false,
  "seed": 42
}