{
  "name": "qwen_evil",
  "description": "CORRSTEER evil steering evaluated on evil",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 18,
    "batch_size": 4,
    "top_k": 15,
    "corrsteer_max_new_tokens": 30,
    "corrsteer_pool": "max",
    "corrsteer_pos_only": true,
    "apply_chat_template": true,
    "corrsteer_reward_evaluator": "agreement",
    "inverse": false
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 18,
    "coeff": 5.0,
    "top_k": 5
  },
  "train_dataset": "evil",
  "n_train": 500,
  "n_test": 100,
  "test_dataset": "evil",
  "output": "./Results/corrsteer",
  "include_baseline": false,
  "compute_perplexity": true,
  "save_vector": "Vector/CORRSTEER/Qwen/evil",
  "seed": 42
}