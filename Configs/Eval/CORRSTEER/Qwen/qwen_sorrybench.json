{
  "name": "qwen_sorrybench",
  "description": "CORRSTEER steering for sorrybench",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 18,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 18,
    "coeff": 1.0,
    "top_k": 5
  },
  "load_vector": "Vector/CORRSTEER/Qwen/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/corrsteer",
  "include_baseline": false,
  "compute_perplexity": true,
  "train_dataset": "sorrybench_refusal_response",
  "n_train": 1000,
  "seed": 42
}