{
  "name": "gemma_coordinate_ab",
  "description": "SAS steering trained on ai_risk_coordinate, evaluated on coordinate_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "corrsteer_max_new_tokens": 1,
    "corrsteer_pool": "max",
    "corrsteer_pos_only": true,
    "apply_chat_template": true
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 14,
    "coeff": 1.0
  },
  "save_vector": "Vector/CORRSTEER/coordinate",
  "train_dataset": "ai_risk_coordinate",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "coordinate_ab",
  "output": "./Results/corrsteer",
  "include_baseline": true
}
