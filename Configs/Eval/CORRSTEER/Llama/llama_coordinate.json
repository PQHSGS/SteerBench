{
  "name": "corrsteer_coordinate",
  "description": "SAS (SAE-based) steering for hallucination reduction, evaluated on math",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "CORRSTEER",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "corrsteer_max_new_tokens": 1,
    "corrsteer_reward_evaluator": "logit",
    "corrsteer_pool": "max",
    "corrsteer_pos_only": true,
    "apply_chat_template": false
  },
  "steer": {
    "method": "CORRSTEER",
    "layer": 14,
    "coeff": 1.0
  },
  "save_vector": "Vector/CORRSTEER/coordinate",
  "train_dataset": "ai_risk_coordinate",
  "n_train": 1000,
  "n_test": 100,
  "test_dataset": "coordinate_ab",
  "output": "./Results/corrsteer"
}
