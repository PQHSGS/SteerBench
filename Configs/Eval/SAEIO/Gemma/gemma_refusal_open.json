{
  "name": "gemma_refusal_open",
  "description": "SAEIO steering for refusal_open",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "batch_size": 4,
    "top_k": 15,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "position": "last",
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "coeff": 0.3,
    "top_k": 5
  },
  "save_vector": "Vector/SAEIO/Gemma/ai_risk_refusal",
  "test_dataset": "refusal_open",
  "train_dataset": "refusal_caa",
  "output": "./Results/saeio",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "n_test": null
}