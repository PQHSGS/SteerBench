{
  "name": "gemma_refusal_ab",
  "description": "SAEIO steering for refusal_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "batch_size": 4,
    "top_k": 15,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "position": -2,
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "coeff": 1,
    "top_k": 5,
    "position": "last"
  },
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "save_vector": "Vector/SAEIO/Gemma/ai_risk_refusal",
  "test_dataset": "refusal_ab",
  "output": "./Results/saeio",
  "seed": 42,
  "n_test": null,
  "include_baseline": false
}