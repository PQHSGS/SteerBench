{
  "name": "gemma_refusal_advbench",
  "description": "SAEIO steering trained on refusal, evaluated on AdvBench",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "batch_size": 4,
    "top_k": 20,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "position": -2,
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "coeff": 1
  },
  "save_vector": "Vector/SAEIO/Gemma/ai_risk_refusal",
  "test_dataset": "advbench",
  "n_test": 1000,
  "output": "./Results/saeio",
  "include_baseline": false,
  "seed": 42
}
