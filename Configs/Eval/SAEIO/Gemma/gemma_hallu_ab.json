{
  "name": "gemma_hallu_ab",
  "description": "SAEIO steering for hallu_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "batch_size": 4,
    "top_k": 15,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "position": -2,
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      14
    ],
    "coeff": 1,
    "top_k": 5
  },
  "n_test": 500,
  "save_vector": "Vector/SAEIO/Gemma/ai_risk_hallucination",
  "train_dataset": "hallucination",
  "test_dataset": "hallucination_ab",
  "output": "./Results/saeio",
  "seed": 42,
  "include_baseline": false
}