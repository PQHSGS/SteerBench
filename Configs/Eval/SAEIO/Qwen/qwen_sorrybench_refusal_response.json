{
  "name": "qwen_sorrybench_refusal_response",
  "description": "SAEIO steering for sorrybench_refusal_response",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      18
    ],
    "batch_size": 4,
    "top_k": 15,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "position": "last",
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      18
    ],
    "coeff": 1.0,
    "top_k": 5
  },
  "load_vector": "Vector/SAEIO/Qwen/refusal_response",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/saeio",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "train_dataset": "sorrybench_refusal_response"
}