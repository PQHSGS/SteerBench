{
  "name": "llama_sorrybench",
  "description": "SAEIO steering trained on refusal, evaluated on SorryBench",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      7
    ],
    "batch_size": 4,
    "top_k": 15,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "position": -2,
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      7
    ],
    "coeff": 1,
    "top_k": 1
  },
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "load_vector": "Vector/SAEIO/Llama/ai_risk_refusal",
  "test_dataset": "sorrybench",
  "n_test": null,
  "output": "./Results/saeio",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}