{
  "name": "llama_refusal_response",
  "description": "SAEIO steering trained on refusal_response, evaluated on refusal_open",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      7
    ],
    "batch_size": 4,
    "top_k": 15,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      7
    ],
    "coeff": 1.0,
    "top_k": 1
  },
  "save_vector": "Vector/SAEIO/Llama/refusal_response",
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "refusal_open",
  "n_test": null,
  "output": "./Results/saeio",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42
}