{
  "name": "llama_hallucination",
  "description": "SAEIO steering trained on hallucination, evaluated on hallucination_ab",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      17
    ],
    "batch_size": 4,
    "top_k": 15,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "position": -2,
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      17
    ],
    "coeff": 1,
    "top_k": 1
  },
  "train_dataset": "hallucination",
  "n_train": 1000,
  "save_vector": "Vector/SAEIO/Llama/ai_risk_hallucination",
  "test_dataset": "hallucination_ab",
  "output": "./Results/saeio",
  "seed": 42
}