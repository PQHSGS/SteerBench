{
  "name": "llama_xstest",
  "description": "SAEIO steering trained on sycophancy, evaluated on corrigible",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAEIO",
    "layer": [
      17
    ],
    "batch_size": 4,
    "top_k": 20,
    "apply_chat_template": true,
    "act_threshold": 20,
    "amp_factor": 10,
    "position": -2,
    "hook_point": "pre"
  },
  "steer": {
    "method": "SAEIO",
    "layer": [
      17
    ],
    "coeff": 1
  },
  "load_vector": "Vector/SAEIO/Llama/ai_risk_refusal",
  "test_dataset": "xstest",
  "output": "./Results/saeio",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}
