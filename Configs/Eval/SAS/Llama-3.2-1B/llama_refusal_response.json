{
  "name": "llama_refusal_response",
  "description": "SAS steering trained on refusal_response, evaluated on refusal_open",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 7,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 7,
    "coeff": 15,
    "top_k": 5
  },
  "save_vector": "Vector/SAS/Llama/refusal_response",
  "train_dataset": "refusal_cast_responses",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "refusal_open",
  "output": "./Results/sas",
  "include_baseline": false,
  "compute_perplexity": true
}