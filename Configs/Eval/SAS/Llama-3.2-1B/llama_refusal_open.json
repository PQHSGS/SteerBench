{
  "name": "llama_refusal_open",
  "description": "SAS steering trained on refusal_caa, evaluated on SorryBench",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 7,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 7,
    "apply_chat_template": true,
    "coeff": 7.5,
    "top_k": 5
  },
  "save_vector": "Vector/SAS/Llama/ai_risk_refusal",
  "n_test": null,
  "train_dataset": "refusal_caa",
  "test_dataset": "refusal_open",
  "output": "./Results/sas",
  "include_baseline": false,
  "compute_perplexity": true
}