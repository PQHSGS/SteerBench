{
  "name": "llama_refusal_ab",
  "description": "SAS steering trained on refusal_caa, evaluated on refusal_ab",
  "model": {
    "name": "meta-llama/Llama-3.2-1B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 7,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "position": -2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 7,
    "coeff": 1.0,
    "top_k": 5
  },
  "save_vector": "Vector/SAS/Llama/ai_risk_refusal",
  "train_dataset": "refusal_caa",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "refusal_ab",
  "output": "./Results/sas",
  "include_baseline": false
}