{
  "name": "llama_coordinate",
  "description": "SAS (SAE-based) steering for hallucination reduction, evaluated on math",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 17,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "position": -2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 17,
    "coeff": 1.0
  },
  "save_vector": "Vector/SAS/Llama/ai_risk_coordinate",
  "train_dataset": "ai_risk_coordinate",
  "n_train": 1000,
  "n_test": 100,
  "test_dataset": "coordinate_ab",
  "output": "./Results/sas",
  "include_baseline": false
}
