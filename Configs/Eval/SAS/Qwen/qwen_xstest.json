{
  "name": "qwen_xstest",
  "description": "SAS steering trained on refusal_caa, evaluated on xstest (over-refusal benchmark)",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 18,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 18,
    "coeff": 1.0,
    "top_k": 5
  },
  "load_vector": "Vector/SAS/Qwen/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "xstest",
  "output": "./Results/sas",
  "include_baseline": false,
  "compute_perplexity": true
}