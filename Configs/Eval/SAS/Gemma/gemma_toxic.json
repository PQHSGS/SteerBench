{
  "name": "gemma_toxic",
  "description": "SAS toxic steering evaluated on toxic",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": false,
    "method": "SAS",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.1,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 14,
    "coeff": 2,
    "top_k": 5
  },
  "train_dataset": "toxic_jigsaw" ,
  "n_test": 100,
"n_train": 500,
  "test_dataset": "toxic",
  "output": "./Results/sas",
  "include_baseline": false,
  "compute_perplexity": true,
  "save_vector": "Vector/SAS/Gemma/toxic",
  "seed": 42
}