{
  "name": "gemma_gms8k",
  "description": "SAS steering trained on srps_roleplay_gms8k, evaluated on gms8k",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 300
  },
  "extractor": {
    "method": "SAS",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "position": "mask",
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 14,
    "coeff": 1.0,
    "top_k": 5
  },
  "save_vector": "Vector/SAS/Gemma/gms8k",
  "train_dataset": "srps_roleplay_gms8k",
  "n_train": 1000,
  "n_test": 100,
  "test_dataset": "gms8k",
  "output": "./Results/sas",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}
