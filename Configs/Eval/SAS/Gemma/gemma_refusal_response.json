{
  "name": "gemma_refusal_response",
  "description": "SAS steering for refusal_response",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.4,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 14,
    "coeff": 2,
    "top_k": 15
  },
  "train_dataset": "refusal_cast_responses",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "refusal_open",
  "output": "./Results/sas",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "save_vector": "Vector/SAS/Gemma/refusal_response"
}