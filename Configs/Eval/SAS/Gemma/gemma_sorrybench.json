{
  "name": "gemma_sorrybench",
  "description": "SAS steering for sorrybench",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 14,
    "coeff": 1.0,
    "top_k": 5
  },
  "load_vector": "Vector/SAS/Gemma/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/sas",
  "include_baseline": false,
  "compute_perplexity": true,
  "train_dataset": "sorrybench_refusal_response",
  "n_train": 1000,
  "seed": 42
}