{
  "name": "gemma_hallu_ab",
  "description": "SAS steering for hallu_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SAS",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "act_frac": 0.2,
    "position": -2,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SAS",
    "layer": 14,
    "coeff": 1.0,
    "top_k": 5,
    "position": "last"
  },
  "save_vector": "Vector/SAS/Gemma/ai_risk_hallucination",
  "train_dataset": "hallucination",
  "n_train": 1000,
  "n_test": 500,
  "test_dataset": "hallucination_ab",
  "output": "./Results/sas",
  "include_baseline": false,
  "seed": 42
}