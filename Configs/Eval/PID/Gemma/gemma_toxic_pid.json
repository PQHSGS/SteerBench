{
  "name": "gemma_toxic_pid",
  "description": "Multi-layer PID steering on toxic (kd=0.01)",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "PID",
    "layer": [8, 10, 12, 14],
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "position": "mask",
    "inverse": false,
    "pid_kp": 1.0,
    "pid_ki": 0.005,
    "pid_kd": 0.02,
    "pid_normalize_error": false
  },
  "steer": {
    "method": "PID",
    "layer": [8, 10, 12, 14],
    "apply_chat_template": true,
    "hook_point": "pre",
    "coeff": 1.0,
    "steer_once": false
  },
  "train_dataset": "toxic_jigsaw",
  "n_train": 500,
  "test_dataset": "toxic",
  "n_test": 100,
  "save_vector": "Vector/PID/Gemma/toxic_pid",
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/pid",
  "seed": 42
}
