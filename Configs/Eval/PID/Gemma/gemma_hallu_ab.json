{
  "name": "gemma_hallu_ab",
  "description": "PID steering on hallucination_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "PID",
    "layer": [14],
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "position": -2,
    "pid_kp": 1.0,
    "pid_ki": 0.005,
    "pid_kd": 0.02,
    "pid_normalize_error": false
  },
  "steer": {
    "method": "PID",
    "layer": [14],
    "apply_chat_template": true,
    "hook_point": "pre",
    "coeff": 1.0
  },
  "train_dataset": "hallucination",
  "n_train": 1000,
  "test_dataset": "hallucination_ab",
  "n_test": 500,
  "save_vector": "Vector/PID/Gemma/ai_risk_hallucination",
  "output": "./Results/pid",
  "seed": 42
}
