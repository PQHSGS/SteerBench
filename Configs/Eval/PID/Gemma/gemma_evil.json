{
  "name": "gemma_evil",
  "description": "PID steering on evil",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "PID",
    "layer": [12,13,14,15,16],
    "batch_size": 4,
    "hook_point": "pre",
    "apply_chat_template": true,
    "position": "last",
    "inverse": false,
    "pid_kp": 1.0,
    "pid_ki": 0.005,
    "pid_kd": 0.3,
    "pid_normalize_error": false
  },
  "steer": {
    "method": "PID",
    "layer": [12,13,14,15,16],
    "apply_chat_template": true,
    "hook_point": "pre",
    "coeff": 1.0,
    "steer_once": false
  },
  "train_dataset": "evil",
  "n_train": 500,
  "test_dataset": "evil",
  "n_test": 100,
  "save_vector": "Vector/PID/Gemma/evil",
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/pid",
  "seed": 42
}
