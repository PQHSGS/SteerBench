{
  "name": "qwen_sorrybench",
  "description": "SRPS steering for sorrybench",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": 18,
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 0.3,
    "beta": 5,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SRPS",
    "layer": 18,
    "coeff": 1.0,
    "batch_size": 4,
    "apply_chat_template": true,
    "norm": true,
    "top_k": 5
  },
  "load_vector": "Vector/SRPS/Qwen/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "sorrybench",
  "output": "./Results/srps",
  "include_baseline": false,
  "compute_perplexity": true,
  "train_dataset": "sorrybench_refusal_response",
  "n_train": 1000,
  "seed": 42
}