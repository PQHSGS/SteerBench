{
  "name": "qwen_roleplay_llama",
  "description": "SRPS (Semantic-Robust Prompt Steering) - uses beta for activation/active-dimension balance",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": [
      29
    ],
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 0.2,
    "beta": 5,
    "apply_chat_template": false
  },
  "steer": {
    "method": "SRPS",
    "layer": [
      29
    ],
    "coeff": 1.0,
    "apply_chat_template": false
  },
  "train_dataset": "srps_roleplay_gms8k",
  "n_train": 1000,
  "test_dataset": "gms8k",
  "output": "./Results/srps"
}