{
  "name": "qwen_ifeval",
  "description": "SRPS steering for ifeval",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": 18,
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 5,
    "beta": 5,
    "apply_chat_template": false
  },
  "steer": {
    "method": "SRPS",
    "layer": 18,
    "coeff": 1.0,
    "apply_chat_template": true,
    "top_k": 5
  },
  "save_vector": "Vector/SRPS/Qwen/ifeval",
  "train_dataset": "ifeval",
  "n_train": 1000,
  "n_test": 100,
  "test_dataset": "ifeval",
  "output": "./Results/srps",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}