{
  "name": "gemma_deception",
  "description": "SRPS steering for deception",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": true,
    "method": "SRPS",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 10,
    "beta": 5,
    "apply_chat_template": true,
    "ot_steer": true
  },
  "steer": {
    "method": "SRPS",
    "layer": 14,
    "coeff": 1.0,
    "apply_chat_template": true,
    "top_k": 5,
    "ot_steer": false
  },
  "load_vector": "Vector/SRPS/Gemma/deception",
  "train_dataset": "liarbench",
  "n_train": 500,
  "n_test": 100,
  "test_dataset": "liarbench",
  "output": "./Results/srps",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}