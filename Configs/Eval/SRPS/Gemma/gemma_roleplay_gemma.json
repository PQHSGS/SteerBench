{
  "name": "gemma_gms8k",
  "description": "SRPS (Semantic-Robust Prompt Steering) - uses beta for activation/active-dimension balance",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": [
      25,
      14
    ],
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 0.2,
    "beta": 5,
    "position": "mask",
    "apply_chat_template": true
  },
  "steer": {
    "method": "SRPS",
    "layer": [
      25
    ],
    "coeff": 5,
    "apply_chat_template": true
  },
  "load_vector": "Vector/SRPS/Gemma/gms8k",
  "test_dataset": "gms8k",
  "output": "./Results/srps",
  "train_dataset": "srps_roleplay_gms8k",
  "n_train": 1000,
  "n_test": 5
}
