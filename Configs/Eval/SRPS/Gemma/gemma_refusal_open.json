{
  "name": "gemma_refusal_open",
  "description": "SRPS steering for refusal_open",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 0.3,
    "beta": 5,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SRPS",
    "layer": 14,
    "coeff": 7.5,
    "apply_chat_template": true,
    "top_k": 5
  },
  "save_vector": "Vector/SRPS/Gemma/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "refusal_open",
  "train_dataset": "refusal_caa",
  "output": "./Results/srps",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}