{
  "name": "gemma_xstest",
  "description": "SRPS steering trained on refusal_caa, evaluated on xstest (over-refusal benchmark)",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": 14,
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 0.3,
    "beta": 5,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SRPS",
    "layer": 14,
    "coeff": 1.0,
    "apply_chat_template": true
  },
  "load_vector": "Vector/SRPS/Gemma/ai_risk_refusal",
  "n_test": null,
  "test_dataset": "xstest",
  "output": "./Results/srps",
  "include_baseline": false,
  "compute_perplexity": true
}
