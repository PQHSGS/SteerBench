{
  "name": "llama_hallu_ab",
  "description": "SRPS steering trained on hallucination, evaluated on hallucination_ab",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": 17,
    "batch_size": 4,
    "top_k": 15,
    "act_threshold": 0.3,
    "position": -2,
    "beta": 5,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SRPS",
    "layer": 17,
    "coeff": 1.0,
    "apply_chat_template": true,
    "top_k": 5
  },
  "save_vector": "Vector/SRPS/Llama/ai_risk_hallucination",
  "train_dataset": "hallucination",
  "n_train": 1000,
  "n_test": null,
  "test_dataset": "hallucination_ab",
  "output": "./Results/srps",
  "include_baseline": true
}