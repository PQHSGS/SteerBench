{
  "name": "llama_roleplay_csqa",
  "description": "SRPS (Semantic-Robust Prompt Steering) - uses beta for activation/active-dimension balance",
  "model": {
    "name": "meta-llama/Llama-3.1-8B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "sae_id": "65",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "SRPS",
    "layer": [
      31
    ],
    "batch_size": 4,
    "top_k": 10,
    "act_threshold": 0.2,
    "beta": 5,
    "apply_chat_template": true
  },
  "steer": {
    "method": "SRPS",
    "layer": [
      31
    ],
    "coeff": 1.0,
    "apply_chat_template": true
  },
  "save_vector": "Vector/SRPS/Llama/csqa_131",
  "test_dataset": "csqa",
  "output": "./Results/srps",
  "train_dataset": "srps_roleplay_csqa",
  "n_train": 1000,
  "n_test": null
}
