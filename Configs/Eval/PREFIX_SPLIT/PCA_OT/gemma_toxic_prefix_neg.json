{
  "name": "gemma_toxic_prefix_neg",
  "description": "PCAOT toxic prefix_neg prefix split",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "ACT",
    "layer": [14],
    "batch_size": 4,
    "hook_point": "pre",
    "position": "mask",
    "apply_chat_template": true,
    "act_mode": "pca_ot",
    "pca_components": 16,
    "inverse": false
  },
  "steer": {
    "method": "ACT",
    "layer": [14],
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 1.0,
    "steer_once": false
  },
  "train_dataset": "toxic_jigsaw_prefix_neg",
  "n_train": 213,
  "test_dataset": "toxic",
  "n_test": 100,
  "save_vector": "Vector/PREFIX_SPLIT/PCA_OT/toxic/prefix_neg",
  "include_baseline": false,
  "compute_perplexity": true,
  "output": "./Results/pcaot",
  "seed": 42
}
