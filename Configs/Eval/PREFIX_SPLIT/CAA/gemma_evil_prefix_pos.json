{
  "name": "gemma_evil_prefix_pos",
  "description": "CAA evil_prefix_pos prefix split",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100,
    "do_sample": false
  },
  "extractor": {
    "method": "CAA",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "mask",
    "apply_chat_template": true,
    "inverse": false
  },
  "steer": {
    "method": "CAA",
    "layer": 14,
    "coeff": 1,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "steer_once": false,
    "batch_size": 4
  },
  "train_dataset": "evil_prefix_pos",
  "n_train": 274,
  "test_dataset": "evil",
  "n_test": 100,
  "output": "./Results/caa",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "save_vector": "Vector/PREFIX_SPLIT/CAA/evil_prefix_pos"
}
