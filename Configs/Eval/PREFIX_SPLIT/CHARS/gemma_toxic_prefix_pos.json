{
  "name": "gemma_toxic_prefix_pos",
  "description": "CHARS toxic prefix_pos prefix split",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100,
    "do_sample": false
  },
  "extractor": {
    "method": "CHARS",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "mask",
    "apply_chat_template": true,
    "inverse": false
  },
  "steer": {
    "method": "CHARS",
    "layer": 14,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "coeff": 5,
    "steer_once": false
  },
  "train_dataset": "toxic_jigsaw_prefix_pos",
  "n_train": 287,
  "test_dataset": "toxic",
  "n_test": 100,
  "output": "./Results/chars",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "save_vector": "Vector/PREFIX_SPLIT/CHARS/toxic_prefix_pos"
}