{
  "name": "gemma_refusal_response",
  "description": "FishBack v2 (gradient-guided flow) steering on refusal task",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "FISHBACK",
    "layer": 14,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "fb_hidden_dim": 128,
    "fb_lr": 0.001,
    "fb_weight_decay": 0.0001,
    "fb_epochs": 30,
    "fb_grad_clip": 1.0,
    "fb_n_steps": 10,
    "fb_n_layers": 2,
    "fb_max_grad_len": 32
  },
  "steer": {
    "method": "FISHBACK",
    "layer": 14,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "coeff": 1.0,
    "steer_once": false
  },
  "train_dataset": "refusal_cast_responses",
  "n_train": 300,
  "test_dataset": "refusal_response",
  "n_test": 100,
  "output": "./Results/fishback",
  "save_vector": "Vector/FISHBACK/Gemma/refusal_response",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}