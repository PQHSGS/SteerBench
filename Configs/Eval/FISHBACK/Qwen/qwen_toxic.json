{
  "name": "qwen_toxic",
  "description": "FishBack v2 (gradient-guided flow) steering on toxic task",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "FISHBACK",
    "layer": 18,
    "batch_size": 4,
    "hook_point": "pre",
    "position": "mask",
    "apply_chat_template": true,
    "fb_hidden_dim": 128,
    "fb_lr": 0.001,
    "fb_weight_decay": 0.0001,
    "fb_epochs": 30,
    "fb_batch_size": 64,
    "fb_grad_clip": 1.0,
    "fb_n_steps": 10,
    "fb_n_layers": 2,
    "fb_max_grad_len": 32
  },
  "steer": {
    "method": "FISHBACK",
    "layer": 18,
    "hook_point": "pre",
    "position": "last",
    "apply_chat_template": true,
    "coeff": 2.0,
    "steer_once": false
  },
  "train_dataset": "toxic_jigsaw",
  "n_train": 100,
  "test_dataset": "toxic",
  "n_test": 100,
  "output": "./Results/fishback",
  "save_vector": "Vector/FISHBACK/Qwen/toxic",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}