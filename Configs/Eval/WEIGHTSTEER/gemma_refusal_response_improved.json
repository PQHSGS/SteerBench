{
  "name": "gemma_refusal_response_improved",
  "description": "WEIGHTSTEER improved steering for refusal_response",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:5",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "WEIGHTSTEER",
    "layer": [
      14
    ],
    "batch_size": 4,
    "weight_steer_lr": 0.0002,
    "weight_steer_epochs": 5,
    "weight_steer_lora_r": 16,
    "weight_steer_lora_alpha": 8,
    "weight_steer_lora_dropout": 0.2,
    "weight_steer_target_modules": [
      "up_proj",
      "down_proj"
    ],
    "weight_steer_lambda_sparse": 0.01
  },
  "steer": {
    "method": "WEIGHTSTEER",
    "layer": [
      14
    ],
    "coeff": 1
  },
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "ifeval",
  "output": "./Results/weightsteer_improved",
  "load_vector": "./Results/weightsteer_improved/vector",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "n_test": 100
}
