{
  "name": "gemma_deception",
  "description": "WEIGHTSTEER steering for deception",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:4",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": true,
    "method": "WEIGHTSTEER",
    "layer": [
      14
    ],
    "batch_size": 4,
    "weight_steer_lr": 0.0002,
    "weight_steer_epochs": 15,
    "apply_chat_template": true,
    "weight_steer_lora_r": 32,
    "weight_steer_lora_alpha": 16,
    "weight_steer_lora_dropout": 0.3,
    "weight_steer_target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "steer": {
    "method": "WEIGHTSTEER",
    "layer": [
      14
    ],
    "coeff": 10
  },
  "train_dataset": "liarbench",
  "test_dataset": "liarbench",
  "output": "./Results/weightsteer",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "n_test": 100,
  "n_train": 500,
  "load_vector": "Vector/WEIGHTSTEER/Gemma/deception"
}