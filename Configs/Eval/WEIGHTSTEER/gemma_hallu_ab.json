{
  "name": "gemma_hallu_ab",
  "description": "WEIGHTSTEER steering for hallu_ab",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "WEIGHTSTEER",
    "layer": [
      14
    ],
    "batch_size": 4,
    "weight_steer_lr": 0.0002,
    "weight_steer_epochs": 7,
    "position": -2,
    "weight_steer_lora_r": 128,
    "weight_steer_lora_alpha": 256,
    "weight_steer_lora_dropout": 0.0,
    "weight_steer_target_modules": [
      "up_proj",
      "down_proj"
    ]
  },
  "steer": {
    "method": "WEIGHTSTEER",
    "layer": [
      14
    ],
    "coeff": 1,
    "position": "last"
  },
  "train_dataset": "hallucination",
  "test_dataset": "hallucination_ab",
  "output": "./Results/weightsteer",
  "compute_perplexity": true,
  "include_baseline": false,
  "seed": 42,
  "n_test": 500,
  "load_vector": "Vector/WEIGHTSTEER/ai_risk_hallucination"
}