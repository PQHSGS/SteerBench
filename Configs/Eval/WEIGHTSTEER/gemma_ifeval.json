{
  "name": "gemma_ifeval",
  "description": "WEIGHTSTEER steering for ifeval",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:4",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "WEIGHTSTEER",
    "layer": [
      14
    ],
    "batch_size": 4,
    "weight_steer_lr": 0.0002,
    "weight_steer_epochs": 7,
    "apply_chat_template": false,
    "weight_steer_lora_r": 128,
    "weight_steer_lora_alpha": 256,
    "weight_steer_lora_dropout": 0.0,
    "weight_steer_target_modules": [
      "up_proj",
      "down_proj"
    ]
  },
  "steer": {
    "method": "WEIGHTSTEER",
    "layer": [
      14
    ],
    "coeff": 1
  },
  "train_dataset": "ifeval",
  "test_dataset": "ifeval",
  "output": "./Results/weightsteer",
  "compute_perplexity": true,
  "include_baseline": true,
  "seed": 42,
  "n_test": 50,
  "save_vector": "Vector/WEIGHTSTEER/Gemma/ifeval"
}