{
  "name": "gemma_refusal_response",
  "description": "ANGULAR steering for refusal_response",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "ANGULAR",
    "layer": 2,
    "batch_size": 8,
    "strategy": "max_sim",
    "hook_point": [
      "mid",
      "post"
    ]
  },
  "steer": {
    "method": "ANGULAR",
    "layer": 22,
    "adaptive": true,
    "target_angle": 0,
    "coeff": 1,
    "apply_all_layers": true,
    "n_test": null
  },
  "train_dataset": "refusal_cast_responses",
  "test_dataset": "refusal_open",
  "save_vector": "Vector/Angular/Gemma/refusal_response",
  "output": "./Results/angular",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "n_test": null
}