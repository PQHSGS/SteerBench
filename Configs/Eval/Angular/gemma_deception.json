{
  "name": "gemma_deception",
  "description": "ANGULAR deception steering evaluated on deception",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "inverse": true,
    "method": "ANGULAR",
    "layer": 2,
    "batch_size": 8,
    "position": -1,
    "strategy": "max_sim",
    "hook_point": [
      "mid",
      "post"
    ]
  },
  "steer": {
    "method": "ANGULAR",
    "layer": 22,
    "adaptive": true,
    "target_angle": 180,
    "coeff": 1,
    "apply_all_layers": true
  },
  "test_dataset": "liarbench",
  "output": "./Results/angular",
  "train_dataset": "liarbench",
  "n_train": 512,
  "n_test": 100,
  "include_baseline": false,
  "compute_perplexity": true
}