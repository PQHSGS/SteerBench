{
  "name": "qwen_sorrybench",
  "description": "ANGULAR steering for sorrybench",
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 100
  },
  "extractor": {
    "method": "ANGULAR",
    "layer": 6,
    "batch_size": 8,
    "position": "last",
    "strategy": "max_sim",
    "hook_point": [
      "mid",
      "post"
    ]
  },
  "steer": {
    "method": "ANGULAR",
    "layer": 26,
    "adaptive": true,
    "target_angle": 0,
    "coeff": 1,
    "apply_all_layers": true,
    "n_test": null
  },
  "train_dataset": "sorrybench_refusal_response",
  "test_dataset": "sorrybench",
  "n_train": 1000,
  "n_test": null,
  "load_vector": "Vector/Angular/Qwen/ai_risk_refusal",
  "output": "./Results/angular",
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42
}