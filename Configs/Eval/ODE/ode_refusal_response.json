{
  "name": "gemma_ode_refusal_response",
  "description": "ODESteer pipeline config for Gemma 2B on refusal_cast_responses — mirrors the ground-truth continuous ODESteer defaults.",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda:4",
    "dtype": "bfloat16",
    "max_new_tokens": 128,
    "do_sample": false
  },
  "extractor": {
    "method": "ODE",
    "layer": [
      14
    ],
    "batch_size": 16,
    "position": "last",
    "apply_chat_template": true,
    "hook_point": "pre",
    "change_pad_token": false,
    "classifier_type": "normed_poly",
    "n_components": 4000,
    "degree": 2,
    "gamma": 0.1,
    "coef0": 1.0,
    "lin_clf_type": "lr",
    "solver": "euler",
    "steps": 20
  },
  "steer": {
    "method": "ODE",
    "layer": [
      14
    ],
    "coeff": 5.0,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "batch_size": 4,
    "apply_all_layers": false,
    "solver": "euler",
    "steps": 20,
    "one_step": false
  },
  "post_process": {},
  "train_dataset": "refusal_cast_responses",
  "n_train": null,
  "test_dataset": "refusal_open",
  "n_test": null,
  "output": "Results/ODE",
  "save_samples": false,
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "load_vector": "Vector/ODE/gemma_refusal_response"
}