{
  "name": "gemma_ifeval",
  "description": "ODE instruction-following steering evaluated on ifeval",
  "model": {
    "name": "google/gemma-2-2b-it",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_new_tokens": 128,
    "do_sample": false
  },
  "extractor": {
    "method": "ODE",
    "layer": [14],
    "batch_size": 16,
    "position": "last",
    "hook_point": "pre",
    "apply_chat_template": true,
    "change_pad_token": false,
    "classifier_type": "normed_poly",
    "n_components": 4000,
    "degree": 2,
    "gamma": 0.1,
    "coef0": 1.0,
    "lin_clf_type": "lr",
    "solver": "euler",
    "steps": 20
  },
  "steer": {
    "method": "ODE",
    "layer": [14],
    "coeff": 1.0,
    "apply_chat_template": true,
    "hook_point": "pre",
    "position": "last",
    "batch_size": 4,
    "apply_all_layers": false,
    "solver": "euler",
    "steps": 20,
    "one_step": false,
    "steer_once": false
  },
  "post_process": {},
  "train_dataset": "ifeval",
  "n_train": null,
  "test_dataset": "ifeval",
  "n_test": 100,
  "output": "Results/ODE",
  "save_samples": false,
  "include_baseline": false,
  "compute_perplexity": true,
  "seed": 42,
  "save_vector": "Vector/ODE/Gemma/ifeval"
}
