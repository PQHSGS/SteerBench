        "CHARS":     {"cfg_dir": "Configs/Eval/CHARS/Gemma"},
        "LinearAcT": {"cfg_dir": "Configs/Eval/LinearAcT/Gemma"},
        "REPS":      {"cfg_dir": "Configs/Eval/REFT"},
        "MANIFOLD":  {"cfg_dir": "Configs/Eval/MANIFOLD/Gemma"},
        "SRPS":      {"cfg_dir": "Configs/Eval/SRPS/Gemma"},
        "WEIGHTSTEER": {"cfg_dir": "Configs/Eval/WEIGHTSTEER"}
    },
    "tasks": ["toxic", "evil", "deception"]
