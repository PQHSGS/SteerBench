{
    "name": "extract_angular_mine",
    "description": "Validation extraction for Angular Steering",
    "save_vector": "Verification/Level1/Angular/my_output/vector.pt",
    "model": {
        "name": "qwen/qwen2.5-3B-Instruct",
        "device": "cuda",
        "dtype": "float32"
    },
    "extractor": {
        "method": "ANGULAR",
        "layer": 0,
        "batch_size": 4,
        "strategy": "max_sim",
        "hook_point": ["mid","post"]
    },
    "steer": {
        "method": "ANGULAR",
        "layer": 16,
        "coeff": 1.0,
        "apply_all_layers": true
    },
    "train_dataset": "angular_validation",
    "n_train": 1000,
    "test_dataset": "csqa"
}